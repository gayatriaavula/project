# .trivyignore — suppress known false positives or accepted risks.
#
# Format: one AVD/CVE ID per line with a comment explaining why it is accepted.
# Keep this list as short as possible — prefer fixing over ignoring.

# ── S3 frontend bucket — intentionally public for static website hosting ──────
# All findings below relate to the frontend S3 bucket which serves a public
# static website. Public access is required by design. No sensitive data is
# stored here — only HTML, CSS, and JS assets.

AVD-AWS-0094    # S3 public access block disabled — frontend website bucket (by design)
AVD-AWS-0132    # S3 not encrypted — public static assets, no sensitive data

AWS-0086        # S3 block public ACL — frontend website requires public ACL (by design)
AWS-0087        # S3 block public policy — frontend website requires public bucket policy
AWS-0091        # S3 ignore public ACL — frontend website bucket must allow public ACL
AWS-0092        # S3 not publicly accessible via ACL — frontend website requires public-read ACL
AWS-0093        # S3 restrict public bucket — frontend website requires public access

AWS-0089        # S3 bucket logging not enabled — static assets only, no sensitive data
AWS-0090        # S3 versioning not enabled — static single-version deployment, no versioning needed

# ── Container image — CVEs in npm's bundled tooling (not app code) ───────────
# These CVEs are in packages used by npm itself (file-matching internals).
# They are not part of our application runtime and cannot be triggered by
# requests to our Express API. Fixed versions require npm to update its
# internal dependency tree in a future node base-image release.

CVE-2026-33672  # picomatch: method injection — in npm glob internals, not app code
CVE-2026-33671  # picomatch: ReDoS — in npm glob internals, not app code
CVE-2026-42338  # ip-address: XSS — browser-only exploit; no HTML rendered in API
CVE-2026-33750  # brace-expansion: DoS — in npm glob internals, not app code

# ── ALB — internet-facing HTTP (intentional for this project) ─────────────────
AWS-0053        # ALB internet-facing — public web app, intentionally internet-facing
AWS-0054        # ALB uses HTTP — no TLS cert configured; acceptable for this project

# ── ECS — container insights (cost feature, not required) ─────────────────────
AWS-0034        # ECS container insights disabled — extra CloudWatch cost; not needed

# ── Security groups — unrestricted egress (containers need internet access) ───
AWS-0104        # Unrestricted egress — ECS/RDS containers need outbound internet access

# ── RDS — settings intentional per environment ────────────────────────────────
AWS-0077        # RDS backup retention < 1 day — dev has 0 days for easy teardown
AWS-0080        # RDS encryption not enabled — existing instances cannot be encrypted without destroy+recreate; planned migration
AWS-0176        # RDS IAM auth disabled — password auth sufficient for this project
AWS-0177        # RDS deletion protection disabled — dev/staging only; prod has it enabled

# ── Networking — public subnets and VPC flow logs ─────────────────────────────
AWS-0164        # Public IP on subnet — needed for ALB and NAT gateway in public subnets
AWS-0178        # VPC flow logs disabled — extra CloudWatch cost; not required

# ── RDS monitoring ────────────────────────────────────────────────────────────
AWS-0133        # RDS Performance Insights disabled — extra cost; not required

# ── KMS Customer Managed Keys — extra cost with minimal added security ─────────
# AWS-managed keys (default) already encrypt CloudWatch logs and ECR at rest.
# CMKs add ~$1/month per key plus cross-service key policy complexity.
AWS-0017        # CloudWatch log group not encrypted with CMK — AWS-managed key in use
AWS-0033        # ECR repository not encrypted with CMK — AWS-managed key in use
