# Copy this file to .env and set your own passwords before running docker-compose.
# The .env file is git-ignored — never commit it.
#
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_USER=appuser
DB_PASSWORD=replace-with-strong-app-password
DB_NAME=sampledb
DB_PORT=3306
PORT=3000
